# Postgres (used by docker compose and by the API when run locally)
POSTGRES_USER=hunthub
POSTGRES_PASSWORD=hunthub
POSTGRES_DB=hunthub
DATABASE_URL=postgres://hunthub:hunthub@localhost:5432/hunthub

# Where the web app's server reaches the API
API_URL=http://localhost:3000

# Better Auth: secret signs sessions (generate with: openssl rand -base64 32).
# URL is the public address of the web app (auth cookies live on it).
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Public URL of the web app when run with docker compose
PUBLIC_URL=http://localhost:3001
