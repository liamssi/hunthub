# Postgres (used by docker compose and by the API when run locally).
# Pick a strong password: openssl rand -hex 24
POSTGRES_USER=hunthub
POSTGRES_PASSWORD=
POSTGRES_DB=hunthub
DATABASE_URL=postgres://hunthub:<POSTGRES_PASSWORD>@localhost:5432/hunthub

# Where the web app's server reaches the API
API_URL=http://localhost:3000

# Better Auth. The secret signs sessions and must be at least 32 characters:
#   openssl rand -base64 32
# BETTER_AUTH_URL is the public address of the web app when running `bun run dev`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Public URL of the web app when run with docker compose. Use https:// for any
# real deployment (auth cookies are then marked Secure).
PUBLIC_URL=http://localhost:3001
# Extra origins allowed to sign in (comma-separated). For local development this
# lets the dev web server on :5173 use the API running in docker.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
